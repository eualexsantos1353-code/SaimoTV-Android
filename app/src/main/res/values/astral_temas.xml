<?xml version="1.0" encoding="utf-8"?>
<!-- Sobreposições de tema do ASTRAL. Tema.kt aplica, nesta ordem, sobre o tema de
     cada tela: modo (Escuro/Claro), wallpaper (fundo e cor de destaque),
     Liquid Glass (opacidade das superfícies) e animações de janela. -->
<resources>
    <style name="AstralEscuro" parent="">
        <item name="astralTexto">#FFFFFFFF</item>
        <item name="astralTextoSecundario">#FFA8B4C0</item>
        <item name="astralTextoSutil">#66FFFFFF</item>
    </style>
    <!-- Claro: só os textos por enquanto. As superfícies ainda são escuras;
         Tema.CLARO_PRONTO continua falso até as telas serem convertidas. -->
    <style name="AstralClaro" parent="">
        <item name="astralTexto">#FF14121C</item>
        <item name="astralTextoSecundario">#FF4A4560</item>
        <item name="astralTextoSutil">#FF8A86A0</item>
    </style>

    <style name="AstralFundoRoxo" parent="">
        <item name="astralFundo">@drawable/wallpaper_roxo</item>
        <item name="astralAccent">#FFB993FF</item>
        <item name="astralAccentSolido">#FF5B3BC4</item>
        <item name="astralAccentFundo">#FF3A2575</item>
        <item name="astralAccentFundo2">#FF22164A</item>
        <item name="astralAccentForte">#FF4A2F9A</item>
        <item name="astralAccentForte2">#FF2A1A62</item>
        <item name="astralBrilho">#FF1B0D3A</item>
    </style>
    <style name="AstralFundoVermelho" parent="">
        <item name="astralFundo">@drawable/wallpaper_vermelho</item>
        <item name="astralAccent">#FFFF7573</item>
        <item name="astralAccentSolido">#FFC43D3B</item>
        <item name="astralAccentFundo">#FF752726</item>
        <item name="astralAccentFundo2">#FF4A1716</item>
        <item name="astralAccentForte">#FF99302E</item>
        <item name="astralAccentForte2">#FF611B1A</item>
        <item name="astralBrilho">#FF3B0E0D</item>
    </style>
    <style name="AstralFundoAzul" parent="">
        <item name="astralFundo">@drawable/wallpaper_azul</item>
        <item name="astralAccent">#FF73A6FF</item>
        <item name="astralAccentSolido">#FF3B6DC4</item>
        <item name="astralAccentFundo">#FF264375</item>
        <item name="astralAccentFundo2">#FF16294A</item>
        <item name="astralAccentForte">#FF2E5599</item>
        <item name="astralAccentForte2">#FF1A3461</item>
        <item name="astralBrilho">#FF0D1E3B</item>
    </style>
    <style name="AstralFundoAmbar" parent="">
        <item name="astralFundo">@drawable/wallpaper_ambar</item>
        <item name="astralAccent">#FFFFB273</item>
        <item name="astralAccentSolido">#FFC4793B</item>
        <item name="astralAccentFundo">#FF754926</item>
        <item name="astralAccentFundo2">#FF4A2D16</item>
        <item name="astralAccentForte">#FF995E2E</item>
        <item name="astralAccentForte2">#FF613A1A</item>
        <item name="astralBrilho">#FF3B210D</item>
    </style>

    <style name="AstralVidroRoxoDesativado" parent="">
        <item name="astralSuperficieA">#FF1D1438</item>
        <item name="astralSuperficieB">#FF120C26</item>
