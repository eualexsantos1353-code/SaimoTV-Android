    <!-- Animações de troca de tela -->
    <style name="AstralJanelaSuaves" parent="">
        <item name="android:activityOpenEnterAnimation">@anim/astral_suave_entra</item>
        <item name="android:activityOpenExitAnimation">@anim/astral_suave_sai</item>
        <item name="android:activityCloseEnterAnimation">@anim/astral_suave_entra</item>
        <item name="android:activityCloseExitAnimation">@anim/astral_suave_sai</item>
    </style>
    <style name="AstralJanelaDinamicas" parent="">
        <item name="android:activityOpenEnterAnimation">@anim/astral_dinamica_entra</item>
        <item name="android:activityOpenExitAnimation">@anim/astral_dinamica_sai</item>
        <item name="android:activityCloseEnterAnimation">@anim/astral_dinamica_entra</item>
        <item name="android:activityCloseExitAnimation">@anim/astral_dinamica_sai</item>
    </style>
    <style name="AstralJanelaDesativadas" parent="">
        <item name="android:activityOpenEnterAnimation">@null</item>
        <item name="android:activityOpenExitAnimation">@null</item>
        <item name="android:activityCloseEnterAnimation">@null</item>
        <item name="android:activityCloseExitAnimation">@null</item>
    </style>
    <style name="AstralAnimSuaves" parent="">
        <item name="android:windowAnimationStyle">@style/AstralJanelaSuaves</item>
    </style>
    <style name="AstralAnimDinamicas" parent="">
