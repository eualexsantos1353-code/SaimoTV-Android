<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Saimo" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@drawable/fundo_app</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:colorAccent">?attr/astralAccent</item>
        <item name="astralTexto">#FFFFFFFF</item>
        <item name="astralTextoSecundario">#FFA8B4C0</item>
        <item name="astralTextoSutil">#66FFFFFF</item>
        <item name="astralAccent">#FFB993FF</item>
        <item name="astralAccentSolido">#FF5B3BC4</item>
        <item name="astralAccentFundo">#FF3A2575</item>
        <item name="astralAccentFundo2">#FF22164A</item>
        <item name="astralAccentForte">#FF4A2F9A</item>
        <item name="astralAccentForte2">#FF2A1A62</item>
        <item name="astralSuperficieA">#FF1D1438</item>
        <item name="astralSuperficieB">#FF120C26</item>
        <item name="astralBrilho">#FF1B0D3A</item>
    </style>

    <!-- Telas de vídeo: fundo preto liso. A imagem de fundo do app (uns 3,7 MB
         decodificada) ficava desenhada por baixo do vídeo a cada quadro sem
         nunca aparecer, porque a tela inteira é coberta pelo player. -->
    <style name="Theme.Saimo.Video">
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- A tela inicial abre no azul da abertura: com a imagem de fundo do app
         na janela, ela piscava antes de o vídeo entrar. -->
    <style name="Theme.Saimo.Abertura">
        <item name="android:windowBackground">@color/abertura_fundo</item>
    </style>

    <!-- Botão do diálogo de listas e do estado vazio: o mesmo bloco claro da
         ficha quando focado. -->
    <style name="BotaoListas">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginEnd">12dp</item>
        <item name="android:background">@drawable/botao_ficha</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:gravity">center</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:paddingStart">24dp</item>
        <item name="android:paddingEnd">24dp</item>
        <item name="android:textColor">@color/texto_botao_ficha</item>
        <item name="android:textSize">20sp</item>
    </style>

    <!-- Um bloco pequeno do painel do Início: ícone em cima e o nome embaixo, centralizados, numa linha só. -->
    <style name="BlocoInicio">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_weight">1</item>
        <item name="android:background">@drawable/bloco_inicio</item>
        <item name="android:focusable">true</item>
        <item name="android:gravity">center</item>
        <item name="android:padding">10dp</item>
        <item name="android:drawablePadding">6dp</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">?attr/astralTexto</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
