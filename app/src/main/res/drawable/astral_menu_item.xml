<?xml version="1.0" encoding="utf-8"?>
<!-- Um item do menu lateral: com o foco, vira um bloco azul com contorno branco;
     a tela em que a pessoa está fica marcada só por uma barrinha em pé na frente do item. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_selected="true">
    <layer-list>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="?attr/astralAccentForte" />
                <stroke android:width="2dp" android:color="#FFFFFFFF" />
                <corners android:radius="14dp" />
            </shape>
        </item>
        <item android:gravity="start|center_vertical">
            <shape android:shape="rectangle">
                <solid android:color="?attr/astralAccent" />
                <size android:width="4dp" android:height="26dp" />
                <corners android:radius="2dp" />
            </shape>
        </item>
    </layer-list>
    </item>
    <item android:state_focused="true">
    <layer-list>
        <item>
            <shape android:shape="rectangle">
                <solid android:color="?attr/astralAccentForte" />
                <stroke android:width="2dp" android:color="#FFFFFFFF" />
                <corners android:radius="14dp" />
            </shape>
        </item>
    </layer-list>
    </item>
    <item android:state_selected="true">
        <layer-list>
        <item android:gravity="start|center_vertical">
            <shape android:shape="rectangle">
                <solid android:color="?attr/astralAccent" />
                <size android:width="4dp" android:height="26dp" />
                <corners android:radius="2dp" />
            </shape>
        </item>
        </layer-list>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
        </shape>
    </item>
</selector>
