<?xml version="1.0" encoding="utf-8"?>
<!-- Linha da lista de canais: focada fica roxa (cor do wallpaper), com contorno. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="0" android:startColor="?attr/astralAccentFundo" android:endColor="?attr/astralAccentForte" />
            <stroke android:width="2dp" android:color="?attr/astralAccent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#22FFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
