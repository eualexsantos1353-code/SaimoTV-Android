<?xml version="1.0" encoding="utf-8"?>
<!-- Linha do menu de Configurações e linhas de opção: com o foco, bloco na cor de destaque com contorno branco;
     a categoria aberta fica com um fundo suave da cor de destaque. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/astralAccentForte" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/astralAccentFundo" />
            <stroke android:width="1dp" android:color="?attr/astralAccent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="2dp" android:color="#00000000" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
