<?xml version="1.0" encoding="utf-8"?>
<!-- O bloco grande do Início (banner): vidro roxo escuro com borda clara; focado, contorno branco. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="?attr/astralAccentForte" android:endColor="?attr/astralAccentForte2" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF35217A" android:endColor="#FF1A1040" />
            <stroke android:width="1.5dp" android:color="#66B993FF" />
            <corners android:radius="22dp" />
        </shape>
    </item>
</selector>
