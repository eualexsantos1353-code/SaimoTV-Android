<?xml version="1.0" encoding="utf-8"?>
<!-- Moldura da prévia: contorno na cor do wallpaper; com foco, branco. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/astralSuperficieB" />
            <stroke android:width="3dp" android:color="#FFFFFFFF" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/astralSuperficieB" />
            <stroke android:width="2dp" android:color="?attr/astralAccentForte" />
            <corners android:radius="20dp" />
        </shape>
    </item>
</selector>
