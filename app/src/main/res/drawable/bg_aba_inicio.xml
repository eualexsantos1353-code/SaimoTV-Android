<?xml version="1.0" encoding="utf-8"?>
<!-- Aba do Início: focada leva contorno branco; a escolhida, preenchimento roxo; as outras só uma borda fina. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF3A2575" />
            <stroke android:width="2dp" android:color="#FFFFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="#FF5B3BC4" />
            <stroke android:width="1dp" android:color="#99FFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#33FFFFFF" />
            <corners android:radius="100dp" />
        </shape>
    </item>
</selector>
