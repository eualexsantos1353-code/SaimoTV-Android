<?xml version="1.0" encoding="utf-8"?>
<!-- Um título da página Nuvio: o pôster (2:3), a barra de progresso quando há, o nome e temporada/episódio ou ano. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="112dp"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/nuvio_foco"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="4dp">
    <FrameLayout
        android:id="@+id/nuvioMoldura"
        android:layout_width="match_parent"
        android:layout_height="156dp"
        android:background="@drawable/nuvio_capa_fundo">
        <TextView
            android:id="@+id/nuvioInicial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:textColor="?attr/astralTextoSecundario"
            android:textSize="34sp" />
        <ImageView
            android:id="@+id/nuvioCapa"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/nuvioProgresso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_gravity="bottom"
            android:max="1000"
            android:progressBackgroundTint="#66FFFFFF"
            android:progressTint="#FFB993FF"
            android:visibility="gone" />
    </FrameLayout>
    <TextView
        android:id="@+id/nuvioNome"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:textColor="?attr/astralTexto"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/nuvioDetalhe"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/astralTextoSecundario"
        android:textSize="12sp" />
</LinearLayout>
