<?xml version="1.0" encoding="utf-8"?>
<!-- Um dia do calendário: o número e um pontinho quando há algo nesse dia. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="52dp"
    android:layout_height="44dp"
    android:layout_margin="2dp"
    android:background="@drawable/agenda_celula"
    android:focusable="true">
    <TextView
        android:id="@+id/agendaDiaNumero"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:paddingBottom="4dp"
        android:textColor="?attr/astralTexto"
        android:textSize="16sp" />
    <View
        android:id="@+id/agendaDiaPonto"
        android:layout_width="6dp"
        android:layout_height="6dp"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="5dp"
        android:background="@drawable/agenda_ponto"
        android:visibility="invisible" />
</FrameLayout>
