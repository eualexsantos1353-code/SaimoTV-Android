<?xml version="1.0" encoding="utf-8"?>
<!-- Uma fileira da tela inicial: o nome dela (com as abas e o "Ver todos", quando tem) e as capas correndo
     para o lado.

     O foco entra pelas capas, nunca pela fileira: quem está no controle anda
     para os lados dentro da fileira e para cima e para baixo entre elas, que é
     como toda TV se comporta. As abas e o "Ver todos" só existem nas fileiras que as pedem. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:descendantFocusability="afterDescendants"
    android:orientation="vertical"
    android:paddingTop="10dp"
    android:paddingBottom="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="26dp"
        android:layout_marginEnd="26dp"
        android:layout_marginBottom="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/filaTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/astralTexto"
            android:textSize="20sp" />
        <LinearLayout
            android:id="@+id/filaModos"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <TextView
                android:id="@+id/filaModo0"
                style="@style/AbaInicio"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/filaModo1"
                style="@style/AbaInicio"
                android:layout_marginEnd="8dp" />
            <TextView
                android:id="@+id/filaModo2"
                style="@style/AbaInicio" />
        </LinearLayout>
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />
        <TextView
            android:id="@+id/filaVerTodos"
            style="@style/AbaInicio"
            android:text="@string/e1_ver_todos"
            android:visibility="gone" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/filaCapas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:clipToPadding="false"
        android:focusable="false"
        android:paddingStart="18dp"
        android:paddingEnd="18dp" />
</LinearLayout>
