<?xml version="1.0" encoding="utf-8"?>
<!-- Configurações (etapa 5): o menu das categorias à esquerda e, à direita, o conteúdo da categoria aberta.
     O fundo é o wallpaper do tema; os painéis usam a superfície do tema (muda com o Liquid Glass). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="40dp"
        android:layout_marginTop="22dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.16"
            android:text="@string/aj_marca"
            android:textColor="?attr/astralTexto"
            android:textSize="22sp"
            android:textStyle="bold" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.2"
            android:text="@string/aj_cabecalho"
            android:textColor="?attr/astralTextoSecundario"
            android:textSize="10sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:layout_marginTop="84dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="24dp"
        android:orientation="horizontal">

        <!-- O menu das categorias. -->
        <LinearLayout
            android:id="@+id/ajMenu"
            android:layout_width="280dp"
            android:layout_height="match_parent"
            android:background="@drawable/aj_painel"
            android:orientation="vertical"
            android:padding="14dp">
            <LinearLayout
                android:id="@+id/ajCatPers"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/aj_linha"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_aj_personalizacao" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/aj_pers"
                    android:textColor="?attr/astralTexto"
                    android:textSize="17sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ajCatControle"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/aj_linha"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_aj_controle" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/aj_controle"
                    android:textColor="?attr/astralTexto"
                    android:textSize="17sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ajCatMais"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/aj_linha"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_aj_mais" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/aj_mais"
                    android:textColor="?attr/astralTexto"
                    android:textSize="17sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ajCatSobre"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:background="@drawable/aj_linha"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_aj_sobre" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:text="@string/aj_sobre"
                    android:textColor="?attr/astralTexto"
                    android:textSize="17sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- O conteúdo da categoria aberta. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="18dp"
            android:layout_weight="1"
            android:background="@drawable/aj_painel"
            android:orientation="vertical"
            android:paddingStart="26dp"
            android:paddingTop="20dp"
            android:paddingEnd="26dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/ajTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:textColor="?attr/astralTexto"
                android:textSize="30sp" />
            <TextView
                android:id="@+id/ajDescricao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/astralTextoSecundario"
                android:textSize="15sp" />
            <TextView
                android:id="@+id/ajCaminho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:letterSpacing="0.1"
                android:text="@string/aj_caminho_aparencia"
                android:textColor="?attr/astralAccent"
                android:textSize="11sp"
                android:visibility="gone" />
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="#22FFFFFF" />

            <FrameLayout
                android:id="@+id/ajCorpo"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <!-- Texto simples: a tela de boas-vindas e as categorias ainda por definir. -->
                <LinearLayout
                    android:id="@+id/ajPgTexto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/ajTextoCorpo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:lineSpacingExtra="4dp"
                        android:textColor="?attr/astralTexto"
                        android:textSize="17sp" />
                    <TextView
                        android:id="@+id/ajTextoNota"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="?attr/astralTextoSecundario"
                        android:textSize="15sp" />
                </LinearLayout>

                <!-- Personalização: Aparência e Tela inicial. -->
                <LinearLayout
                    android:id="@+id/ajPgPers"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
            <LinearLayout
                android:id="@+id/ajRowAparencia"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/aj_linha"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/aj_aparencia"
                    android:textColor="?attr/astralTexto"
                    android:textSize="19sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/aj_aparencia_linha"
                    android:textColor="?attr/astralTextoSecundario"
                    android:textSize="14sp" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ajRowTelaInicial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:background="@drawable/aj_linha"
                android:focusable="true"
                android:orientation="vertical"
                android:paddingStart="18dp"
                android:paddingTop="14dp"
                android:paddingEnd="18dp"
                android:paddingBottom="14dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/aj_tela_inicial"
                    android:textColor="?attr/astralTexto"
                    android:textSize="19sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/aj_tela_inicial_linha"
                    android:textColor="?attr/astralTextoSecundario"
                    android:textSize="14sp" />
            </LinearLayout>
                </LinearLayout>

                <!-- Aparência: montada pelo código (AparenciaPainel). -->
                <ScrollView
                    android:id="@+id/ajPgAparencia"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:scrollbars="none"
                    android:visibility="gone">
                    <LinearLayout
                        android:id="@+id/ajAparenciaConteudo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingBottom="16dp" />
                </ScrollView>

                <!-- Mais ajustes: a lista que já existia (reprodução, geral, sistema). -->
                <br.com.saimo.tv.ListaSemFuga
                    android:id="@+id/ajustesLista"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="24dp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
