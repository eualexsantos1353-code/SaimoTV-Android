<?xml version="1.0" encoding="utf-8"?>
<!-- A página Nuvio: menu lateral, marca com o botão Abrir Nuvio e duas fileiras. Nada além disso. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/astralFundo">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="64dp"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="28dp"
        android:paddingEnd="40dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.12"
                    android:text="@string/nuvio_marca"
                    android:textColor="?attr/astralTexto"
                    android:textSize="34sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/nuvio_frase"
                    android:textColor="?attr/astralTextoSecundario"
                    android:textSize="16sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/nuvioAbrir"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/bg_ao_vivo_categoria"
                android:fontFamily="sans-serif-medium"
                android:focusable="true"
                android:gravity="center"
                android:paddingStart="28dp"
                android:paddingEnd="28dp"
                android:text="@string/nuvio_abrir"
                android:textColor="@color/texto_botao_ficha"
                android:textSize="18sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/nuvioAviso"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="8dp"
            android:textColor="?attr/astralTextoSecundario"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- Trakt: a conexão só pede a pessoa quando falta, e explica para que serve. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/nuvioTraktTexto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="?attr/astralTextoSecundario"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/nuvioTraktCodigo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:letterSpacing="0.2"
                android:textColor="?attr/astralTexto"
                android:textSize="34sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/nuvioTraktBotao"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_ao_vivo_categoria"
                android:focusable="true"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="24dp"
                android:paddingEnd="24dp"
                android:textColor="@color/texto_botao_ficha"
                android:textSize="16sp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/nuvio_continuar"
            android:textColor="?attr/astralTexto"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/nuvioContinuarVazio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/nuvio_vazio"
            android:textColor="?attr/astralTextoSutil"
            android:textSize="15sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:fontFamily="sans-serif-medium"
            android:text="@string/nuvio_minha_lista"
            android:textColor="?attr/astralTexto"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/nuvioListaVazio"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/nuvio_vazio"
            android:textColor="?attr/astralTextoSutil"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- O menu lateral: fechado são só os ícones; com o foco abre por cima do conteúdo. -->
    <LinearLayout
        android:id="@+id/nuvioMenu"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />
</FrameLayout>
