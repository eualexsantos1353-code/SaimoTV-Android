<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão de canal ao vivo (2:1): o logo no meio, o nome embaixo e o selo AO VIVO no canto. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="176dp"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:background="@drawable/canal_foco"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="4dp">
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="92dp"
        android:background="@drawable/bg_canal">
        <TextView
            android:id="@+id/capaInicial"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:paddingBottom="22dp"
            android:textColor="#FFB993FF"
            android:textSize="28sp" />
        <ImageView
            android:id="@+id/capaImagem"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:paddingStart="30dp"
            android:paddingTop="8dp"
            android:paddingEnd="30dp"
            android:paddingBottom="26dp"
            android:scaleType="fitCenter"
            android:visibility="gone" />
        <TextView
            android:id="@+id/capaNome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingBottom="6dp"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
        <TextView
            android:id="@+id/eventoSelo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:background="@drawable/bg_chip"
            android:fontFamily="sans-serif-medium"
            android:paddingStart="6dp"
            android:paddingTop="1dp"
            android:paddingEnd="6dp"
            android:paddingBottom="1dp"
            android:textColor="#FFFFFFFF"
            android:textSize="9sp"
            android:visibility="gone" />
        <ProgressBar
            android:id="@+id/capaProgresso"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_gravity="bottom"
            android:max="1000"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
