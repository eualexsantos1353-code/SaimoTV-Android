<?xml version="1.0" encoding="utf-8"?>
<!-- A tela inicial: o painel (busca, relógio, Continuar ao vivo e os atalhos) em cima, com a imagem do título
     focado ao fundo, e as fileiras embaixo. Fundo escuro neutro, só nesta tela. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_inicio">

    <!-- Imagem do título focado e os degradês que a escurecem: aparecem
         juntos, e sem título focado fica só o fundo do app. -->
    <FrameLayout
        android:id="@+id/inicioFundoGrupo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0">
        <ImageView
            android:id="@+id/inicioFundo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_destaque_lado" />
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_destaque_baixo" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="64dp"
        android:clipChildren="false"
        android:orientation="vertical">

        <!-- O painel: topo com o nome, a busca e o relógio; o bloco grande (Continuar ao vivo, com o que passa
             agora pelo guia) e os quatro atalhos ao lado. -->
        <LinearLayout
            android:id="@+id/inicioPainel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginEnd="48dp"
            android:layout_marginTop="2dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/inicio_painel_nome"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp" />
                <TextView
                    android:id="@+id/inicioBusca"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="24dp"
                    android:layout_marginEnd="24dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_busca_inicio"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="@string/inicio_painel_buscar"
                    android:textColor="#B4B2A9"
                    android:textSize="15sp" />
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/inicioHora"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text_primary"
                        android:textSize="26sp" />
                    <TextView
                        android:id="@+id/inicioData"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#B4B2A9"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <FrameLayout
                    android:id="@+id/inicioContinuar"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2.2"
                    android:background="@drawable/bloco_inicio_principal"
                    android:focusable="true">
                    <ImageView
                        android:id="@+id/inicioContinuarLogo"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="16dp"
                        android:background="@drawable/bg_logo_inicio"
                        android:contentDescription="@null"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:orientation="vertical"
                        android:padding="18dp">
                        <TextView
                            android:id="@+id/inicioContinuarRotulo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:drawablePadding="6dp"
                            android:textColor="#CECBF6"
                            android:textSize="15sp" />
                        <TextView
                            android:id="@+id/inicioContinuarCanal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:textColor="@color/text_primary"
                            android:textSize="26sp" />
                        <TextView
                            android:id="@+id/inicioContinuarPrograma"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textColor="#CECBF6"
                            android:textSize="16sp" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Os atalhos: três cartões largos, com ícone, nome e seta. Ajustes fica no menu lateral. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:id="@+id/inicioProgramacao"
                        style="@style/AtalhoInicio"
                        android:text="@string/inicio_painel_programacao" />
                    <TextView
                        android:id="@+id/inicioEventos"
                        style="@style/AtalhoInicio"
                        android:layout_marginTop="10dp"
                        android:text="@string/inicio_painel_eventos" />
                    <TextView
                        android:id="@+id/inicioFavoritos"
                        style="@style/AtalhoInicio"
                        android:layout_marginTop="10dp"
                        android:text="@string/inicio_painel_favoritos" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- O destaque antigo (título, informações e sinopse do item focado) fica escondido: a imagem do item
             focado continua ao fundo, e quem mostrava o texto segue funcionando sem aparecer. -->
        <LinearLayout
            android:id="@+id/inicioDestaque"
            android:layout_width="620dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/inicioTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/inicioMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/inicioSinopse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <br.com.saimo.tv.ListaSemFuga
            android:id="@+id/inicioFilas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="false"
            android:layout_marginTop="10dp"
            android:paddingBottom="120dp" />
    </LinearLayout>

    <!-- O menu lateral: fechado são só os ícones (64dp); com o foco nele abre por cima do conteúdo e mostra os nomes. -->
    <LinearLayout
        android:id="@+id/inicioMenu"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <TextView
        android:id="@+id/escolhaStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_card"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:textColor="@color/text_primary"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>
