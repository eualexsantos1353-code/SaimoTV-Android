<?xml version="1.0" encoding="utf-8"?>
<!-- A tela inicial: o painel (busca, relógio, Continuar ao vivo e os atalhos) em cima, com a imagem do título
     focado ao fundo, e as fileiras embaixo. Fundo escuro neutro, só nesta tela. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/astralFundo">

    <!-- Imagem do título focado e os degradês que a escurecem: aparecem
         juntos, e sem título focado fica só o fundo do app. -->
    <FrameLayout
        android:id="@+id/inicioFundoGrupo"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0">
        <ImageView
            android:id="@+id/inicioFundo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@null"
            android:scaleType="centerCrop" />
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_destaque_lado" />
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_destaque_baixo" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/inicioConteudo"
        android:layout_marginStart="64dp"
        android:clipChildren="false"
        android:orientation="vertical">

        <!-- O topo: o logo ASTRAL TV, a busca de canais, o sino das notificações e o relógio. -->
        <LinearLayout
            android:id="@+id/inicioPainel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="18dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_astral" />
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.16"
                    android:paddingBottom="10dp"
                    android:text="@string/astral_marca"
                    android:textColor="?attr/astralTexto"
                    android:textSize="22sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom|end"
                    android:letterSpacing="0.2"
                    android:text="@string/astral_tv"
                    android:textColor="#FFC4B5FD"
                    android:textSize="10sp" />
            </FrameLayout>

            <TextView
                android:id="@+id/inicioBusca"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="28dp"
                android:layout_marginEnd="24dp"
                android:layout_weight="1"
                android:background="@drawable/bg_busca_inicio"
                android:focusable="true"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/astral_buscar"
                android:textColor="#B4B2A9"
                android:textSize="15sp" />

            <!-- O sino da Central de Notificações, com o número dos avisos não vistos. -->
            <FrameLayout
                android:id="@+id/inicioSino"
                android:layout_width="48dp"
                android:layout_height="40dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/ntf_sino_foco"
                android:contentDescription="@string/ntf_sino"
                android:focusable="true">
                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:layout_gravity="center"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sino" />
                <TextView
                    android:id="@+id/inicioSinoContador"
                    android:layout_width="wrap_content"
                    android:layout_height="18dp"
                    android:layout_gravity="top|end"
                    android:background="@drawable/ntf_badge"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:minWidth="18dp"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">
                <TextView
                    android:id="@+id/inicioHora"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/astralTexto"
                    android:textSize="26sp" />
                <TextView
                    android:id="@+id/inicioData"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#B4B2A9"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- O banner: um filme ou série em alta (TMDB), com "Assistir agora" abrindo no Nuvio. -->
        <FrameLayout
            android:id="@+id/inicioBanner"
            android:layout_width="match_parent"
            android:layout_height="214dp"
            android:layout_marginStart="18dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="48dp"
            android:background="@drawable/bg_banner_inicio">
            <ImageView
                android:id="@+id/bannerFundo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@null"
                android:scaleType="centerCrop" />
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_destaque_lado" />
            <View
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_destaque_baixo" />
            <LinearLayout
                android:layout_width="520dp"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|start"
                android:orientation="vertical"
                android:padding="22dp">
                <TextView
                    android:id="@+id/bannerTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_tag_banner"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="10dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="2dp"
                    android:textColor="#FFFFFFFF"
                    android:textSize="12sp" />
                <TextView
                    android:id="@+id/bannerTitulo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="1"
                    android:textColor="#FFFFFFFF"
                    android:textSize="34sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/bannerMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFC4B5FD"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/bannerSinopse"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="#FFE7E5EE"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/inicioBannerAssistir"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/ntf_acao"
                    android:focusable="true"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:paddingStart="24dp"
                    android:paddingEnd="24dp"
                    android:text="@string/astral_assistir"
                    android:textColor="@color/agenda_texto_pilula"
                    android:textSize="16sp"
                    android:visibility="invisible" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/bannerPontos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="18dp"
                android:orientation="horizontal" />
        </FrameLayout>

        <!-- O destaque antigo (título, informações e sinopse do item focado) fica escondido: a imagem do item
             focado continua ao fundo, e quem mostrava o texto segue funcionando sem aparecer. -->
        <LinearLayout
            android:id="@+id/inicioDestaque"
            android:layout_width="620dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">
            <TextView
                android:id="@+id/inicioTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/inicioMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
            <TextView
                android:id="@+id/inicioSinopse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <br.com.saimo.tv.ListaSemFuga
            android:id="@+id/inicioFilas"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="true"
            android:clipToPadding="false"
            android:layout_marginTop="10dp"
            android:paddingBottom="120dp" />
    </LinearLayout>

    <!-- O menu lateral: fechado são só os ícones (64dp); com o foco nele abre por cima do conteúdo e mostra os nomes. -->
    <LinearLayout
        android:id="@+id/inicioMenu"
        android:layout_width="64dp"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp" />

    <!-- O painel da Central de Notificações: abre à direita, por cima do Início. -->
    <LinearLayout
        android:id="@+id/ntfPainel"
        android:layout_width="400dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:layout_marginTop="72dp"
        android:layout_marginEnd="24dp"
        android:layout_marginBottom="20dp"
        android:background="@drawable/ntf_painel"
        android:elevation="12dp"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_sino"
                android:tint="#FF8B5CF6" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/ntf_titulo"
                android:textColor="?attr/astralTexto"
                android:textSize="22sp" />
            <TextView
                android:id="@+id/ntfNovas"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:background="@drawable/ntf_pilula"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#FFFFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>
        <TextView
            android:id="@+id/ntfVazio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="?attr/astralTextoSecundario"
            android:textSize="15sp"
            android:visibility="gone" />
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/ntfLista"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:focusable="false" />
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/ntf_rodape"
            android:textColor="?attr/astralTextoSutil"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/ntfFechar"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginTop="10dp"
            android:background="@drawable/agenda_pilula"
            android:focusable="true"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/ntf_fechar"
            android:textColor="@color/agenda_texto_pilula"
            android:textSize="16sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/escolhaStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="28dp"
        android:background="@drawable/bg_card"
        android:paddingStart="18dp"
        android:paddingTop="8dp"
        android:paddingEnd="18dp"
        android:paddingBottom="8dp"
        android:textColor="?attr/astralTexto"
        android:textSize="15sp"
        android:visibility="gone" />
</FrameLayout>
